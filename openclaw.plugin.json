{
  "id": "memory-lancedb-pro",
  "name": "Memory LanceDB Pro",
  "version": "4.2.5",
  "kind": "memory",
  "description": "Capability-first LanceDB memory plugin with hybrid retrieval, wiki tools, and host interop (v3)",
  "configSchema": {
    "type": "object",
    "properties": {
      "dbPath": {
        "type": "string",
        "description": "Database storage path (required)"
      },
      "connectionMode": {
        "type": "string",
        "enum": [
          "embedded",
          "remote"
        ],
        "default": "embedded",
        "description": "Connection mode: embedded (local) or remote (server)"
      },
      "tableName": {
        "type": "string",
        "default": "memories",
        "description": "Table name in LanceDB"
      },
      "embeddingDimension": {
        "type": "integer",
        "default": 2560,
        "description": "Embedding dimension"
      },
      "readConsistencyIntervalSeconds": {
        "type": "number",
        "default": 5,
        "description": "Seconds between checks for external writes (0=strong consistency, >0=eventual)"
      },
      "defaultScope": {
        "type": "string",
        "default": "default",
        "description": "Default memory scope"
      },
      "retrieval": {
        "type": "object",
        "properties": {
          "hybrid": {
            "type": "boolean",
            "default": true
          },
          "rerank": {
            "type": "boolean",
            "default": false
          },
          "rerankProvider": {
            "type": "string",
            "enum": [
              "none",
              "dashscope"
            ],
            "default": "none"
          },
          "rerankModel": {
            "type": "string",
            "default": "qwen3-vl-rerank"
          },
          "rerankBaseUrl": {
            "type": "string",
            "default": "https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank"
          },
          "rerankApiKeyEnv": {
            "type": "string",
            "default": "DASHSCOPE_API_KEY"
          },
          "fts": {
            "type": "boolean",
            "default": true,
            "description": "Enable FTS full-text search index"
          }
        }
      },
      "hostInterop": {
        "type": "object",
        "properties": {
          "enableArtifacts": {
            "type": "boolean",
            "default": true
          },
          "enableEvents": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "assetsTableName": {
        "type": "string",
        "default": "memory_assets"
      },
      "assetsPath": {
        "type": "string",
        "description": "Assets directory path"
      },
      "vault": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Wiki vault path"
          }
        }
      },
      "context": {
        "type": "object",
        "properties": {
          "includeCompiledDigestPrompt": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "obsidian": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "workingMemory": {
        "type": "object",
        "description": "Working-memory（工作任务）task store (v4.1). Independent LanceDB table with per-agent lane isolation.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable memory_wm_* tools and working_memory table (default: true; set false to fully unload)"
          },
          "tableName": {
            "type": "string",
            "default": "working_memory"
          },
          "crossAgentWriteAllowlist": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "main"
            ],
            "description": "Agent ids allowed to write other lanes (main-agent 代管权); all other agents are lane-isolated for writes"
          },
          "yamlFormatDefault": {
            "type": "boolean",
            "default": false,
            "description": "Default output format for memory_wm_get (false=json, true=yaml)"
          }
        }
      },
      "embedding": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "default": "dashscope"
          },
          "model": {
            "type": "string",
            "default": "tongyi-embedding-vision-flash-2026-03-06"
          },
          "baseUrl": {
            "type": "string",
            "default": "https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding"
          },
          "apiKeyEnv": {
            "type": "string",
            "default": "DASHSCOPE_API_KEY"
          },
          "nativeDimension": {
            "type": "integer",
            "default": 768
          },
          "storageDimension": {
            "type": "integer",
            "default": 2560
          }
        }
      },
      "storageOptions": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "description": "Storage options for remote LanceDB (S3/etc); supports ${ENV_VAR} interpolation"
      },
      "autoRecall": {
        "type": "boolean",
        "default": false,
        "description": "Enable automatic memory recall at before_prompt_build (default: false, 灰度原则)"
      },
      "recallMaxChars": {
        "type": "integer",
        "default": 1000,
        "description": "Maximum character length for recall query normalization (default: 1000)"
      },
      "recallMinScore": {
        "type": "number",
        "default": 0.7,
        "minimum": 0,
        "maximum": 1,
        "description": "Minimum relevance score for auto-recall injection (score=1/(1+cosine_distance); 0.7≈cosine similarity ≥0.57). Below threshold → no injection at all."
      },
      "dreaming": {
        "type": "object",
        "description": "Dreaming engine configuration (M4). Default disabled — enable only after testing gateway startup impact.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable dreaming sweep engine (default: false). Warning: enable only after verifying gateway startup overhead <2s."
          },
          "frequency": {
            "type": "string",
            "default": "0 3 * * *",
            "description": "Daily cron expression for sweep scheduling (e.g. '0 3 * * *' for 3AM, '@daily' for midnight)"
          },
          "timezone": {
            "type": "string",
            "default": "Asia/Shanghai",
            "description": "IANA timezone for cron scheduling (default: Asia/Shanghai)"
          },
          "verboseLogging": {
            "type": "boolean",
            "default": false,
            "description": "Enable verbose debug logging for dreaming sweeps"
          },
          "phases": {
            "type": "object",
            "description": "Per-phase configuration (light=dedup, deep=promotion, rem=pattern insight)",
            "properties": {
              "light": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "lookbackDays": {
                    "type": "integer",
                    "default": 2,
                    "minimum": 0
                  },
                  "limit": {
                    "type": "integer",
                    "default": 100,
                    "minimum": 0
                  },
                  "dedupeSimilarity": {
                    "type": "number",
                    "default": 0.92,
                    "minimum": 0,
                    "maximum": 1
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "deep": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "limit": {
                    "type": "integer",
                    "default": 10,
                    "minimum": 0
                  },
                  "minScore": {
                    "type": "number",
                    "default": 0.6,
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minRecallCount": {
                    "type": "integer",
                    "default": 3,
                    "minimum": 0
                  },
                  "minUniqueQueries": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0
                  },
                  "recencyHalfLifeDays": {
                    "type": "integer",
                    "default": 14,
                    "minimum": 1
                  },
                  "maxAgeDays": {
                    "type": "integer",
                    "default": 90,
                    "minimum": 1
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "rem": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "lookbackDays": {
                    "type": "integer",
                    "default": 7,
                    "minimum": 0
                  },
                  "limit": {
                    "type": "integer",
                    "default": 10,
                    "minimum": 0
                  },
                  "minPatternStrength": {
                    "type": "number",
                    "default": 0.6,
                    "minimum": 0,
                    "maximum": 1
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "reflection": {
        "type": "object",
        "description": "Reflection engine configuration (M3). Default disabled — enable only after testing.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable reflection distiller at agent_end (default: false, 灰度原则)"
          },
          "distillerModel": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "Model for distiller sub-session (null=follow agent default model)"
          },
          "maxConcurrency": {
            "type": "integer",
            "default": 2,
            "minimum": 1,
            "description": "Max concurrent distiller runs per agent lane"
          },
          "derivedMaxAgeDays": {
            "type": "integer",
            "default": 14,
            "minimum": 1,
            "description": "Max age in days for derived reflection items (older items pruned from injection)"
          },
          "mappedMaxAgeDays": {
            "type": "integer",
            "default": 60,
            "minimum": 1,
            "description": "Max age in days for mapped reflection items"
          },
          "admissionPreset": {
            "type": "string",
            "enum": [
              "balanced",
              "conservative",
              "high-recall"
            ],
            "default": "balanced",
            "description": "Admission control preset for mapped reflection entries"
          }
        }
      }
    },
    "required": [
      "dbPath"
    ]
  },
  "activation": {
    "onStartup": true,
    "onCommands": [
      "wiki"
    ]
  },
  "hooks": {
    "timeoutMs": 60000
  },
  "contracts": {
    "tools": [
      "memory_store",
      "memory_list",
      "memory_recall",
      "memory_update",
      "memory_archive",
      "memory_promote",
      "memory_stats",
      "memory_debug",
      "memory_migrate_legacy",
      "memory_forget",
      "wiki_status",
      "wiki_new",
      "wiki_get",
      "wiki_query",
      "wiki_build",
      "wiki_doctor",
      "wiki_index",
      "wiki_sync_links",
      "wiki_traverse",
      "wiki_path",
      "wiki_search",
      "memory_wm_get",
      "memory_wm_create",
      "memory_wm_update",
      "memory_wm_append",
      "memory_wm_list",
      "memory_wm_archive"
    ]
  },
  "commandAliases": [
    {
      "name": "wiki"
    }
  ]
}
